# Copy to .env (git-ignored). Never commit real values.
# "replay" needs no key; "groq" needs GROQ_API_KEY.
DOCGATE_PROVIDER=replay
GROQ_API_KEY=
DOCGATE_GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high
DOCGATE_REASONING_EFFORT=low
# strict | best_effort | json_object
DOCGATE_STRUCTURED_MODE=strict
DOCGATE_RECORDED_DIR=data/recorded
